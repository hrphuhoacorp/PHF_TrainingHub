{
  "rewrites": [
    {
      "source": "/api/task-recurrence-cron",
      "destination": "/api/checklist-monthly-cron?__phf_cron=task-recurrence"
    },
    {
      "source": "/api/task-mail-cron",
      "destination": "/api/checklist-monthly-cron?__phf_cron=task-mail"
    },
    {
      "source": "/api/task-weekly-report-cron",
      "destination": "/api/checklist-monthly-cron?__phf_cron=task-weekly-report"
    },
    {
      "source": "/api/evidence",
      "destination": "/api/task-attachment?__phf_route=evidence"
    },
    {
      "source": "/evidence/:id",
      "destination": "/api/task-attachment?id=:id&__phf_route=evidence"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/site.webmanifest"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/print/commitments/:id",
      "destination": "/print-commitment.html"
    },
    {
      "source": "/print/evaluations/:id",
      "destination": "/print-evaluation.html"
    },
    {
      "source": "/forms/:type/print",
      "destination": "/print-form.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/build-info.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-PHF-Build",
          "value": "1.66.8"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/((?!api|assets|build-info.json).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/data/phf-lessons-new-sales.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
