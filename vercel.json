{
  "routes": [
    { "src": "^/(lib|scripts)(/.*)?$", "status": 404 },
    { "src": "^/server\\.js$", "status": 404 },
    { "src": "^/render\\.yaml$", "status": 404 },
    { "src": "^/(app|phf-evaluation|phf-hr-home|phf-knl-app|phf-url-router)\\.js$", "status": 404 },
    { "src": "^/(phf-hr-home|phf-knl)\\.css$", "status": 404 },
    { "src": "^/LEGACY_CODE\\.md$", "status": 404 },
    { "src": "^/.*\\.(cmd|ps1)$", "status": 404 },

    { "src": "^/build-info\\.json$", "headers": { "Cache-Control": "no-store, max-age=0", "X-PHF-Build": "1.65.9" }, "continue": true },
    { "src": "^/index\\.html$", "headers": { "Cache-Control": "no-store, max-age=0" }, "continue": true },
    { "src": "^/assets/css/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/js/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/data/phf-lessons-new-sales\\.js$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(?!api|assets|build-info\\.json).*$", "headers": { "Cache-Control": "no-store, max-age=0" }, "continue": true },

    { "handle": "filesystem" },

    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "src": "^/evidence/(?<id>[^/]+)$", "dest": "/api/evidence?id=$id" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/site\\.webmanifest$", "dest": "/site.webmanifest" },
    { "src": "^/favicon\\.ico$", "dest": "/favicon.ico" },
    { "src": "^/print/commitments/(?<id>[^/]+)$", "dest": "/print-commitment.html" },
    { "src": "^/print/evaluations/(?<id>[^/]+)$", "dest": "/print-evaluation.html" },
    { "src": "^/forms/(?<type>[^/]+)/print$", "dest": "/print-form.html" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
