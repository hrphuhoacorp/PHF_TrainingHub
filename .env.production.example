# KHÔNG đưa file thật chứa secret lên GitHub.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PHF_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PHF_PRIVATE_DIR=/var/data/phf-private
PHF_PUBLIC_URL=https://training.phuhoafresh.info.vn
PHF_BOOTSTRAP_ADMIN_EMAIL=your-admin@phuhoafresh.com
PHF_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
PHF_BOOTSTRAP_ADMIN_NAME=PHF Admin
PHF_ENABLE_TEST_ACCOUNTS=false

# ---------------------------------------------------------------------------
# PHF TASK — MAIL CONTRACT V1 (Vercel env). ALL default OFF. The transactional
# outbox + weekly report stay dormant in PROD until an authorized operator
# sets these AND applies migrations/phf_hr_task_mail_v1.sql + sets
# PHF_TASK_MAIL_OUTBOX_ENABLED=true on the phf-hr-api service.
# ---------------------------------------------------------------------------
# Master switch for the Vercel mail drainer (/api/task-mail-cron). Not 'true' => inert.
PHF_TASK_MAIL_V1_ENABLED=false
# Bearer secret for the mail drain cron route (its own, not shared with the
# recurrence/checklist cron secrets). Generate: openssl rand -hex 32
TASK_MAIL_CRON_SECRET=
# Brevo transactional provider. Absent => drainer records provider_not_configured
# and sends nothing (never a business failure).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PHF Task
# Absolute base URL for the "Mở PHF Task" deep link in emails.
TASK_MAIL_BASE_URL=https://hr.phuhoafresh.info.vn
# --- Weekly Report (Increment 2). BOTH this flag AND
#     task.mail_settings.weekly_report_enabled (Admin UI) must be true. ---
PHF_TASK_WEEKLY_REPORT_ENABLED=false
# Bearer secret for the weekly-report cron route (its own). openssl rand -hex 32
TASK_WEEKLY_REPORT_CRON_SECRET=
