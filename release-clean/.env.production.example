# KHÔNG đưa file thật chứa secret lên GitHub.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PHF_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PHF_PRIVATE_DIR=/var/data/phf-private
PHF_PUBLIC_URL=https://training.phuhoafresh.info.vn
PHF_BOOTSTRAP_ADMIN_EMAIL=your-admin@phuhoafresh.com
PHF_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
PHF_BOOTSTRAP_ADMIN_NAME=PHF Admin
PHF_ENABLE_TEST_ACCOUNTS=false
