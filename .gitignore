/scripts/task-training-acceptance-persona-emails.json

# PHF Task Mail V1 — offline HTML previews generated from SYNTHETIC demo data
# for visual review only (scripts/task-mail-preview-generate.js). Not fixtures.
/tmp/

# QTTH Accounting Data V1 — operator source files (FAST export, cost dictionary,
# KTT management-cost reference). CHỨA DỮ LIỆU KẾ TOÁN THẬT — never commit.
/phf-qtth-input/

# QTTH Truth Data PROD bootstrap — CONFIDENTIAL payloads (employee-level payroll
# salary + vendor/customer accounting rows). Machine-fed to the importer ONLY,
# NEVER committed. Only the sanitized manifest/*.json (counts/fingerprints/totals)
# under docs/qtth-truth-bootstrap/ is committable.
/scripts/qtth-truth-bootstrap/_secure/
/scripts/qtth-truth-bootstrap/*.secure.json

# QTTH Payroll corpus — Operator REAL workbooks (employee names + salary +
# per-employee tax IDs). NEVER committed. Kept only in the gitignored secure
# path scripts/qtth-truth-bootstrap/_secure/payroll-corpus/ and fed to the
# tests / package builder via scripts/lib/payroll-corpus-dir.js.
/docs/payroll-corpus/*.tsv
/scripts/fixtures/payroll/
